{"headers": ["Unnamed: 0", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565"], "rows": [{"Unnamed: 0": "\u76c8\u5229\u53ef\u9810\u6e2c\u6027", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u4e0d\u53ef\u9810\u6e2c", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "\u53ef\u9810\u6e2c"}, {"Unnamed: 0": "\u5168\u5e74\u4f48\u5c40", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u53ea\u6709\u7c21\u55ae\u7684\u77ed\u671f\u6016\u5c40", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "\u5168\u5e74\u4f48\u5c40\uff0c\u6642\u9593\u662f\u670b\u53cb"}, {"Unnamed: 0": "\u5009\u4f4d\u7ba1\u7406", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u50b3\u7d71\u5009\u4f4d\u7ba1\u7406\u6a21\u5f0f", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "AI\u512a\u5316\u5009\u4f4d\u7ba1\u7406\ufe55\n\u8907\u5229\u6548\u679c\u540c\u6642\u9ad8\u98a8\u63a7\u96d9\u9a45\u52d5\u6a21\u578b"}, {"Unnamed: 0": "\u9577\u4e2d\u77ed\u7dda\u6295\u8cc7\u7b56\u7565", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u53ea\u5c08\u6ce8\u77ed\u7dda\u6216\u4e2d\u9577\u7dda\u4ea4\u6613", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "AI\u512a\u5316\u5b8c\u6574\u6295\u8cc7\u7d44\u5408\ufe55\n\u4e2d\u9577\u7dda\u6295\u8cc7\u52dd\u738799.9%\n\u77ed\u7dda\u65e5\u5167\u4ea4\u6613\u52dd\u738780%-90%"}, {"Unnamed: 0": "\u98a8\u63a7", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u904e\u65bc\u4fdd\u5b88\u6216\u904e\u65bc\u9032\u53d6", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "\u6a5f\u69cb\u7d1a\u98a8\u63a7\u52a0\u4e0aAI\u512a\u5316\uff0c\n\u540c\u6642\u5177\u5099\u98a8\u63a7\u53ca\u8907\u5229\u6548\u679c"}, {"Unnamed: 0": "\u65e5\u5167\u4ea4\u6613\u52dd\u7387\u504f\u4f4e", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "40-60%\u52dd\u7387", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "80-90%\u52dd\u7387"}, {"Unnamed: 0": "\u76ef\u76e4", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u4eba\u624b\u76ef\u76e4\uff0c\u7cbe\u795e\u640d\u8017\u5927\uff0c\n\u5bb9\u6613\u51fa\u932f", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "\u8c6a\u79d2\u7d1aAI\u76ef\u76e4\uff0c\u5be6\u6642\u7b56\u7565\uff0c\u81ea\u52d5\u4ea4\u6613\u3002"}, {"Unnamed: 0": "\u6b62\u76c8\u6b62\u640d\u4ea4\u6613\u7b56\u7565", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u770bK\u7dda\u770b\u6307\u6a19", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "AI\u6df1\u5ea6\u5206\u6790\uff0c\u8a02\u5236\u6700\u512a\u7b56\u7565"}, {"Unnamed: 0": "\u9810\u6e2c", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u900f\u904e\u6280\u8853\u6307\u6a19\u4f5c\u9810\u6e2c", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "\u4e0d\u4f5c\u9810\u6e2c\uff0c\u5168\u7a0bAI\u56de\u6e2c\uff0c\n\u7368\u5bb6\u53c3\u6578\u8a13\u7df4"}, {"Unnamed: 0": "\u5167\u5e55\u6d88\u606f", "\u4e00\u822c\u6295\u8cc7\u7b56\u7565": "\u4f9d\u8cf4\u865b\u5047\u7684\u5167\u5e55\u6d88\u606f", "\u8ca1\u795e\u7cfb\u7d71AI\u7b56\u7565": "\u4e0d\u4f9d\u8cf4\u4efb\u4f55\u5167\u5e55\u6d88\u606f"}]}